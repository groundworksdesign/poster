2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     if: github.ref_type != 'tag' || !contains(github.ref_name, '-pr.')
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     name: Resolve version
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     runs-on: ubuntu-latest
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     outputs:
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       version: ${{ steps.resolve.outputs.version }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       is_prerelease: ${{ steps.resolve.outputs.is_prerelease }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       commit_sha: ${{ steps.resolve.outputs.commit_sha }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       pr_number: ${{ steps.resolve.outputs.pr_number }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       skip_build: ${{ steps.resolve.outputs.skip_build }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     permissions:
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       contents: write
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       pull-requests: read
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)     steps:
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       - name: Checkout
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)         uses: actions/checkout@v4
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)         with:
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)           fetch-depth: 0
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)       - name: Resolve version
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)         id: resolve
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)         env:
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)           GH_TOKEN: ${{ github.token }}
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)         run: |
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)           set -euo pipefail
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)           if [ '${{ github.ref_type }}' = 'tag' ]; then
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # -----------------------------------------------------------------
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Tag push — final release. Use the tag name as-is.
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Skip duplicate builds when the tag points at the automated
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # post-merge version-bump commit (main-branch run already built).
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # -----------------------------------------------------------------
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             TAG_NAME='${{ github.ref_name }}'
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             COMMIT_MSG=$(git log -1 --format=%B)
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             if echo "$COMMIT_MSG" | grep -qE 'Bump version to .* \[skip ci\]'; then
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               echo "skip_build=true" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             else
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               echo "skip_build=false" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             fi
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "version=$TAG_NAME" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "is_prerelease=false" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "commit_sha=${{ github.sha }}" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "pr_number=" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             if ! gh release view "$TAG_NAME" >/dev/null 2>&1; then
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               gh release create "$TAG_NAME" --draft --title "$TAG_NAME" --notes "Release assets building..."
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             fi
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)           else
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # -----------------------------------------------------------------
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Main push — final release. Detect +semver:, bump package.json,
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # commit [skip ci], push, create and push final release tag.
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # -----------------------------------------------------------------
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "skip_build=false" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             CURRENT_VER=$(node -p "require('./package.json').version")
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Find merged PR
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             PR_NUMBER=$(gh api "/repos/${{ github.repository }}/commits/${{ github.sha }}/pulls" \
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               --jq '.[0].number // empty')
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "pr_number=$PR_NUMBER" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # PR body + merge commit body
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             PR_BODY=""
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             [ -n "$PR_NUMBER" ] && PR_BODY=$(gh api "/repos/${{ github.repository }}/pulls/$PR_NUMBER" \
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               --jq '.body // empty')
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             COMMIT_MSG=$(git log --format=%B -n1 "${{ github.sha }}")
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             ALL_TEXT=$(printf '%s\n%s' "$PR_BODY" "$COMMIT_MSG")
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             BUMP="patch"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             if echo "$ALL_TEXT" | grep -qiE '\+semver:\s?(breaking|major)'; then
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               BUMP="major"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             elif echo "$ALL_TEXT" | grep -qiE '\+semver:\s?(feature|minor)'; then
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               BUMP="minor"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             fi
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Apply bump — NOTE: post-increment in ((..)) returns the OLD value;
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # if old value is 0 the arithmetic exits with code 1, which trips
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # `set -e`. Use explicit arithmetic instead.
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VER"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             case "$BUMP" in
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               patch) PATCH=$((PATCH + 1)) ;;
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             esac
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             NEW_VER="${MAJOR}.${MINOR}.${PATCH}"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             TAG_NAME="v${NEW_VER}"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Write version to package.json
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             node -e "
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               const p = require('./package.json');
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               p.version = '$NEW_VER';
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)               require('fs').writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             "
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Commit [skip ci] and push
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git config user.name 'github-actions[bot]'
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git config user.email 'github-actions[bot]@users.noreply.github.com'
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git add package.json
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git commit -m "Bump version to $NEW_VER [skip ci]"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git push origin "refs/heads/${{ github.ref_name }}"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             # Create and push final release tag
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git tag "$TAG_NAME"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             git push origin "$TAG_NAME"
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             gh release create "$TAG_NAME" --draft --title "$TAG_NAME" --notes "Release assets building..."
2026-09-07T01:29:58.458Z [dev/opencode] (stderr)             echo "version=$TAG_NAME" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.459Z [dev/opencode] (stderr)             echo "is_prerelease=false" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.459Z [dev/opencode] (stderr)             echo "commit_sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
2026-09-07T01:29:58.459Z [dev/opencode] (stderr)           fi
2026-09-07T01:29:58.459Z [dev/opencode] (stderr)   # ---------------------------------------------------------------------------
