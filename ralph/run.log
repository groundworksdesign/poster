2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   --plan-model <name>
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   --dev-model <name>
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   --qa-model <name>
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   --agent-backend copilot|cursor-agent|claude|gemini|opencode
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   --dev-reasoning-effort <level> (low|medium|high|xhigh)
