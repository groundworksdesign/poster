2026-09-07T01:59:25.074Z [dev/opencode] (stderr) set -euo pipefail
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) # Ralph launcher
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) # Builds the UI and starts the API server.
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) # Experiment under this repo (Kanban + --repo experiments/<slug>):
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   ./start.sh exp <slug>
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) # Example (headless run until epic complete):
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) # ./start.sh \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --repo /absolute/path/to/target-repo \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --plan-model claude-sonnet-4.6 \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --dev-model gpt-5-mini \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --qa-model gpt-5-mini \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --dev-reasoning-effort xhigh \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --qa-reasoning-effort high \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --max-llm-calls 300 \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --plan-frequency 1 \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --min-backlog-size 3 \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --auto-commit false \
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) #   --exit-when-complete
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) cd "$(dirname "$0")"
2026-09-07T01:59:25.074Z [dev/opencode] (stderr) list_experiment_slugs() {
2026-09-07T01:59:25.074Z [dev/opencode] (stderr)   local count=0
