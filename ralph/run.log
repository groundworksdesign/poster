2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   fi
2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   set -- --repo "$repo" "$@"
2026-09-07T01:59:25.076Z [dev/opencode] (stderr) fi
2026-09-07T01:59:25.076Z [dev/opencode] (stderr) if [ ! -d "node_modules" ]; then
