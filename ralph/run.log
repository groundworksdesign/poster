2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   fi
2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   slug="$2"
2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   shift 2
2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   repo="$(pwd)/experiments/${slug}"
2026-09-07T01:59:25.076Z [dev/opencode] (stderr)   if [ ! -d "$repo" ]; then
