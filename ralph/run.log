2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   fi
2026-09-07T01:59:25.075Z [dev/opencode] (stderr) }
2026-09-07T01:59:25.075Z [dev/opencode] (stderr) if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
