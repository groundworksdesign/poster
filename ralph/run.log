2026-09-07T01:59:25.075Z [dev/opencode] (stderr)     base="${base##*/}"
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)     if [ -f "${d}requirements.md" ] || [ -f "${d}REQUIREMENTS.md" ] || [ -f "${d}Requirements.md" ] \
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)       || [ -f "${d}docs/requirements.md" ] || [ -f "${d}docs/REQUIREMENTS.md" ]; then
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)       echo "  $base"
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)       count=$((count + 1))
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)     fi
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   done
2026-09-07T01:59:25.075Z [dev/opencode] (stderr)   if [ "$count" -eq 0 ]; then
