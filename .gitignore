# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
!/build/index.js

# Remix: browser bundles + HMR output (regenerated; hashed names cause constant git churn)
/public/build/

# Tooling caches that may appear in the repo root
/.cache/

# Playwright output (local test runs)
/test-results/
/playwright-report/
/blob-report/

# CRA: generated from public/cra-index.html by scripts/sync-cra-index.cjs (must not be committed — Remix would serve it for `/`).
public/index.html

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite database files
*.sqlite
*.sqlite-wal
*.sqlite-shm

# JSON library fallback (when better-sqlite3 is unavailable)
poster.library.json

# Portable zip build output
/dist/
# Ralph agent trees (removed from repo; keep ignored if recreated locally)
/ralph/
/.ralph/
