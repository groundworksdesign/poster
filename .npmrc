# react-scripts (CRA) expects a flat ESLint plugin graph; pnpm’s isolated linker can
# load eslint-config-react-app twice and trigger: "Plugin react was conflicted between …"
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*@typescript-eslint*
public-hoist-pattern[]=eslint
public-hoist-pattern[]=eslint-config-react-app
